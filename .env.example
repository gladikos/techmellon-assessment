# === Anthropic (used by simulator, evaluator, and fixers) ===
ANTHROPIC_API_KEY=sk-ant-your-key-here

# === ElevenLabs (used by the airline agent) ===
ELEVENLABS_API_KEY=sk_your-elevenlabs-key-here
ELEVENLABS_AGENT_ID=agent_id_after_you_create_one

# === Backend server ===
BACKEND_BASE_URL=http://localhost:8000

# === Refinement loop configuration ===
PASS_THRESHOLD=8
MAX_ITERATIONS=5

# === Model selection (override defaults if needed) ===
SIMULATOR_MODEL=claude-haiku-4-5
EVALUATOR_MODEL=claude-sonnet-4-6
FIXER_MODEL=claude-sonnet-4-6